rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCompanyMember(companyId) {
      return isAuthenticated() && exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    function isCompanyOwner(companyId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/companies/$(companyId)) && 
         get(/databases/$(database)/documents/companies/$(companyId)).data.ownerUid == request.auth.uid) ||
        (exists(/databases/$(database)/documents/companies/$(companyId)) && 
         get(/databases/$(database)/documents/companies/$(companyId)).data.createdBy == request.auth.uid)
      );
    }

    function canAccessCompany(companyId) {
      return isAuthenticated() && (isCompanyOwner(companyId) || isCompanyMember(companyId));
    }

    // User Profile Documents
    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // Company Tenant Partitions (Strict Multi-Tenant Isolation)
    match /companies/{companyId} {
      // Allow read only if user belongs to this organization
      allow read: if canAccessCompany(companyId);
      
      // Allow creation of a new company by an authenticated user, or update if owner/admin
      allow create: if isAuthenticated();
      allow update, delete: if isCompanyOwner(companyId);

      // Subcollections: strictly restricted to verified tenant members
      match /members/{memberUid} {
        allow read: if canAccessCompany(companyId);
        allow write: if canAccessCompany(companyId);
      }

      match /invitations/{invitationId} {
        allow read: if canAccessCompany(companyId) || (isAuthenticated() && resource.data.email == request.auth.token.email);
        allow write: if canAccessCompany(companyId);
      }

      match /branches/{branchId} {
        allow read: if canAccessCompany(companyId);
        allow write: if canAccessCompany(companyId);
      }

      match /auditLogs/{logId} {
        allow read: if canAccessCompany(companyId);
        // Audit logs can be written by members, but never updated or deleted (Immutable)
        allow create: if canAccessCompany(companyId);
        allow update, delete: if false;
      }

      match /challans/{challanId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /recycleBin/{challanId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /customers/{customerId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /products/{productId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /settings/{settingId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /subscription/{docId} {
        allow read: if canAccessCompany(companyId);
        allow write: if isCompanyOwner(companyId);
      }

      match /transporters/{transporterId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /warehouses/{warehouseId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /inventoryMovements/{movementId} {
        allow read: if canAccessCompany(companyId);
        // Movements are append-only to preserve ledger integrity
        allow create: if canAccessCompany(companyId);
        allow update, delete: if false;
      }

      match /stockAdjustments/{adjustmentId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /warehouseTransfers/{transferId} {
        allow read, write: if canAccessCompany(companyId);
      }

      match /goodsReceipts/{receiptId} {
        allow read, write: if canAccessCompany(companyId);
      }
    }
  }
}
